# ── Database ──────────────────────────────────────────────
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=devpulse
DATABASE_URL=postgresql://devpulse:CHANGE_ME_STRONG_PASSWORD@db:5432/devpulse

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Django ────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING_50_CHARS
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── GitHub ────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
GITHUB_APP_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=your_github_username

# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key
LLM_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=production